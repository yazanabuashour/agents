#!/usr/bin/env python3
import json
from pathlib import Path
import re

import yaml

root = Path(__file__).resolve().parent.parent
for skill in sorted((root / "skills").iterdir()):
    path = skill / "SKILL.md"
    text = path.read_text()
    parts = text.split("---", 2)
    if len(parts) != 3 or parts[0].strip():
        raise SystemExit(f"Missing skill frontmatter: {path}")
    metadata = yaml.safe_load(parts[1])
    if not isinstance(metadata, dict) or metadata.get("name") != skill.name:
        raise SystemExit(f"Skill name must match its directory: {path}")
    description = metadata.get("description")
    if not isinstance(description, str) or not description.strip():
        raise SystemExit(f"Missing skill description: {path}")
    for source in skill.rglob("*"):
        if source.is_symlink():
            raise SystemExit(f"Do not vendor source symlinks: {source}")
        if source.suffix == ".json":
            json.loads(source.read_text())
        elif source.suffix == ".yaml":
            yaml.safe_load(source.read_text())

baseline = (root / "instructions/AGENTS.md").read_text()
if re.search(r"Todoist|agent-browser|~/notes", baseline):
    raise SystemExit("Conditional personal workflows must stay out of the baseline.")
writing = root / "skills/technical-writing"
if "disable-model-invocation: true" not in (writing / "SKILL.md").read_text():
    raise SystemExit("Technical writing must remain manual-only in Pi and Claude Code.")
if yaml.safe_load((writing / "agents/openai.yaml").read_text()) != {"policy": {"allow_implicit_invocation": False}}:
    raise SystemExit("Technical writing must remain manual-only in Codex.")
print("Personal skill checks passed.")
