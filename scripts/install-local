#!/usr/bin/env python3
import argparse
import difflib
import os
from pathlib import Path
import shutil
import stat
import tempfile


def main():
    parser = argparse.ArgumentParser(
        description="Preview personal agent files; --apply backs up and installs only those files."
    )
    parser.add_argument("--apply", action="store_true")
    args = parser.parse_args()
    root = Path(__file__).resolve().parent.parent
    home = Path.home()
    for directory in (root / "instructions", root / "skills", root / "bin"):
        if directory.is_symlink():
            raise SystemExit(f"Source must not be a symlink: {directory}")
    skills = sorted((root / "skills").rglob("*"))
    helpers = sorted((root / "bin").iterdir())
    for source in (*skills, *helpers):
        if source.is_symlink():
            raise SystemExit(f"Source must not be a symlink: {source}")
    files = [(root / "instructions/AGENTS.md", home / ".agents/AGENTS.md", 0o600)]
    files.extend(
        (source, home / ".agents" / source.relative_to(root), 0o644)
        for source in skills if source.is_file()
    )
    files.extend(
        (source, home / ".local/bin" / source.name, 0o755)
        for source in helpers if source.is_file()
    )
    changes = []
    for source, target, mode in files:
        if source.is_symlink() or not source.is_file():
            raise SystemExit(f"Source must be a regular file: {source}")
        for path in (target, *target.parents):
            if path == home:
                break
            if path.is_symlink():
                raise SystemExit(f"Refusing to write through a symlink: {path}")
            if path != target and path.exists() and not path.is_dir():
                raise SystemExit(f"Target parent must be a directory: {path}")
        if target.exists() and not target.is_file():
            raise SystemExit(f"Target must be a regular file: {target}")
        before = target.read_bytes() if target.exists() else b""
        after = source.read_bytes()
        old_mode = stat.S_IMODE(target.stat().st_mode) if target.exists() else None
        if target.exists() and before == after and old_mode == mode:
            continue
        print(f"{target}: mode {oct(old_mode) if old_mode is not None else 'absent'} -> {oct(mode)}")
        try:
            before_text, after_text = before.decode(), after.decode()
        except UnicodeDecodeError:
            print("Non-UTF-8 content; no text diff. Inspect the source before applying.")
        else:
            print("".join(difflib.unified_diff(
                before_text.splitlines(keepends=True),
                after_text.splitlines(keepends=True),
                fromfile=str(target), tofile=str(source),
            )), end="")
        changes.append((target, mode, after))
    if not args.apply:
        print("Preview only. Run scripts/install-local --apply to install these files.")
        return
    if not changes:
        print("Personal agent files already match.")
        return
    state = Path(os.environ.get("XDG_STATE_HOME") or home / ".local/state")
    if not state.is_absolute():
        state = home / ".local/state"
    state /= "agents/backups"
    state.mkdir(parents=True, exist_ok=True)
    backup = Path(tempfile.mkdtemp(prefix="install-", dir=state))
    for target, _, _ in changes:
        if target.exists():
            saved = backup / target.relative_to(home)
            saved.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(target, saved)
    print(f"Backups: {backup}")
    for target, mode, content in changes:
        target.parent.mkdir(parents=True, exist_ok=True)
        fd, temporary = tempfile.mkstemp(prefix=f".{target.name}.", dir=target.parent)
        try:
            with os.fdopen(fd, "wb") as output:
                output.write(content)
                os.fchmod(output.fileno(), mode)
            os.replace(temporary, target)
        finally:
            if os.path.exists(temporary):
                os.unlink(temporary)
    print("Installed personal agent files. Existing sessions were not reloaded.")


if __name__ == "__main__":
    main()
