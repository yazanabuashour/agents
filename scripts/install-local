#!/usr/bin/env python3
import argparse
import hashlib
import json
import os
from pathlib import Path, PurePosixPath
import stat
import tempfile


INSTRUCTION_LINKS = {
    ".pi/agent/AGENTS.md": "../../.agents/AGENTS.md",
    ".codex/AGENTS.md": "../.agents/AGENTS.md",
    ".claude/rules/personal.md": "../../.agents/AGENTS.md",
    ".config/opencode/AGENTS.md": "../../.agents/AGENTS.md",
    ".gemini/AGENTS.md": "../.agents/AGENTS.md",
}
SKILL_LINK_ROOTS = {
    (".claude", "skills"): "../../.agents/skills",
    (".gemini", "config", "skills"): "../../../.agents/skills",
}


def fail(message):
    raise SystemExit(message)


def check_target(path, root, link=False):
    for ancestor in reversed(path.parents):
        if ancestor == root or not ancestor.is_relative_to(root):
            continue
        if ancestor.is_symlink():
            fail(f"Refusing to write through a symlink: {ancestor}")
        if ancestor.exists() and not ancestor.is_dir():
            fail(f"Target parent must be a directory: {ancestor}")
    if path.is_symlink() and not link:
        fail(f"Refusing to write through a symlink: {path}")


def fingerprint(path):
    if path.is_symlink():
        return {"target": os.readlink(path)}
    if not path.exists():
        return None
    if not path.is_file():
        fail(f"Target must be a regular file or profile link: {path}")
    return {
        "sha256": hashlib.sha256(path.read_bytes()).hexdigest(),
        "mode": stat.S_IMODE(path.stat().st_mode),
    }


def read_receipt(path):
    if not path.exists():
        return {"version": 1, "paths": {}, "directories": []}
    try:
        receipt = json.loads(path.read_text())
    except (OSError, ValueError) as error:
        fail(f"Invalid receipt {path}: {error}")
    if (
        not isinstance(receipt, dict)
        or receipt.get("version") != 1
        or not isinstance(receipt.get("paths"), dict)
        or not isinstance(receipt.get("directories"), list)
    ):
        fail(f"Invalid receipt schema: {path}")
    return receipt


def atomic_write(target, content, mode):
    fd, temporary = tempfile.mkstemp(prefix=f".{target.name}.", dir=target.parent)
    try:
        with os.fdopen(fd, "wb") as output:
            output.write(content)
            os.fchmod(output.fileno(), mode)
        os.replace(temporary, target)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def main():
    parser = argparse.ArgumentParser(
        description="Preview profile copies, harness links, and ownership cleanup; "
                    "--apply installs and --check fails when pending changes exist."
    )
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--apply", action="store_true")
    mode.add_argument("--check", action="store_true")
    args = parser.parse_args()

    root = Path(__file__).resolve().parent.parent
    home = Path.home()
    state = Path(os.environ.get("XDG_STATE_HOME") or home / ".local/state")
    if not state.is_absolute():
        state = home / ".local/state"
    state /= "agents"
    receipt_path = state / "installed.json"
    check_target(receipt_path, home)
    old = read_receipt(receipt_path)

    for directory in (root / "instructions", root / "skills", root / "bin"):
        if not directory.is_dir():
            fail(f"Source must be a directory: {directory}")
    exported = sorted(path.parent for path in (root / "skills").glob("*/SKILL.md") if path.is_file())
    files = [
        (root / "instructions/AGENTS.md", ".agents/AGENTS.md", 0o600),
        (root / "instructions/codex.md", ".codex/minimal-codex.md", 0o600),
    ]
    files.extend(
        (source, str(Path(".agents") / source.relative_to(root)), 0o644)
        for skill in exported
        for source in sorted(skill.rglob("*"))
        if source.is_file()
    )
    files.extend(
        (source, f".local/bin/{source.name}", 0o755)
        for source in sorted((root / "bin").iterdir())
        if source.is_file()
    )

    desired = {}
    copies = {}
    for source, name, mode in files:
        content = source.read_bytes()
        desired[name] = {"sha256": hashlib.sha256(content).hexdigest(), "mode": mode}
        copies[name] = (source.relative_to(root), content)
    desired.update({name: {"target": target} for name, target in INSTRUCTION_LINKS.items()})

    shared = home / ".agents/skills"
    skill_names = {skill.name for skill in exported}
    if shared.is_dir():
        for skill in shared.iterdir():
            marker = str(Path(".agents/skills") / skill.name / "SKILL.md")
            if skill.is_dir() and (skill / "SKILL.md").is_file() and (
                marker in desired or marker not in old["paths"]
            ):
                skill_names.add(skill.name)
    for root_parts, rel_base in SKILL_LINK_ROOTS.items():
        prefix = "/".join(root_parts)
        for name in sorted(skill_names):
            desired[f"{prefix}/{name}"] = {"target": f"{rel_base}/{name}"}

    changes = []
    owned = {}
    for name in sorted(old["paths"].keys() | desired.keys()):
        target = home / name
        after = desired.get(name)
        is_link = (after is not None and "target" in after) or "target" in old["paths"].get(name, {})
        check_target(target, home, link=is_link)
        before = fingerprint(target)
        if name in old["paths"] and before is not None and before != old["paths"][name]:
            fail(f"Local modification conflicts with ownership receipt: {target}. "
                 "Save or reconcile the local change before reinstalling.")
        if after is None:
            if before is not None:
                changes.append((name, None))
            continue
        if name not in old["paths"] and before is not None:
            if "target" in after:
                if name in INSTRUCTION_LINKS:
                    if before != after:
                        fail(f"Unowned instruction path conflicts: {target}")
                    print(f"Preserve unowned matching instruction link: {target}")
                    continue
                if "target" not in before or (target.parent / before["target"]).resolve() != (
                    target.parent / after["target"]
                ).resolve():
                    fail(f"Unowned skill path conflicts: {target}")
                print(f"Preserve unowned matching link: {target}")
                continue
            if before.get("sha256") != after["sha256"]:
                fail(f"Unowned file differs: {target}. Reconcile it against the source before installing.")
            print(f"Record matching profile file: {target}")
        owned[name] = after
        if before != after:
            changes.append((name, after))

    required = set()
    for name, entry in desired.items():
        if "sha256" in entry:
            required.update(
                str(parent) for parent in PurePosixPath(name).parents
                if len(parent.parts) >= 3 and parent.parts[:2] == (".agents", "skills")
            )
    directories = set(old["directories"])
    directories.update(name for name in required if not (home / name).exists())
    removed = {name for name, after in changes if after is None}
    trimmed = []
    for name in sorted(directories, key=lambda n: (-len(PurePosixPath(n).parts), n)):
        target = home / name
        if not target.exists() and name not in required:
            directories.remove(name)
        elif name not in required and all(
            str(child.relative_to(home)) in removed for child in target.iterdir()
        ):
            trimmed.append(name)
            removed.add(name)
            directories.remove(name)

    receipt = {"version": 1, "paths": owned, "directories": sorted(directories)}
    receipt_changed = receipt != old or not receipt_path.exists()

    for name, after in changes:
        target = home / name
        if after is None:
            print(f"Remove owned path: {target}")
        elif "target" in after:
            print(f"Link: {target} -> {after['target']}")
        else:
            source, _ = copies[name]
            print(f"Copy: {source} -> {target} (mode {oct(after['mode'])})")
    for name in trimmed:
        print(f"Remove empty owned directory: {home / name}")
    if receipt_changed:
        print(f"Record ownership: {receipt_path}")

    pending = bool(changes or trimmed or receipt_changed)
    if args.check and pending:
        fail("Installed profile differs from source; run scripts/install-local --apply to install this plan.")
    if not args.apply and not args.check:
        print("Preview only. Run scripts/install-local --apply to install this plan.")
        return
    if not pending:
        print("Personal agent files and harness links already match.")
        return

    state.mkdir(parents=True, exist_ok=True)
    for name, after in changes:
        target = home / name
        if after is None:
            target.unlink()
        else:
            target.parent.mkdir(parents=True, exist_ok=True)
            if "target" in after:
                target.symlink_to(after["target"], target_is_directory=name not in INSTRUCTION_LINKS)
            else:
                _, content = copies[name]
                atomic_write(target, content, after["mode"])
    for name in trimmed:
        (home / name).rmdir()
    atomic_write(receipt_path, (json.dumps(receipt, indent=2, sort_keys=True) + "\n").encode(), 0o600)
    print("Installed personal agent files and harness links. Existing sessions were not reloaded.")


if __name__ == "__main__":
    main()
