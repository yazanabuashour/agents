#!/usr/bin/env bash
set -Eeuo pipefail

if [[ ${CHECKPOINT_REVIEW_TEST_MOCK:-} == 1 ]]; then
  case "${0##*/}" in
    fd | fdfind | rg)
      [[ ${CHECKPOINT_REVIEW_TEST_PREFLIGHT:-} != "${0##*/}" && ${CHECKPOINT_REVIEW_TEST_PREFLIGHT:-} != all-fd ]]
      exit
      ;;
    model-role)
      printf 'openai-codex/fixture-deep\n'
      exit
      ;;
    forbidden)
      touch "$CHECKPOINT_REVIEW_TEST_OUTPUT/helper-ran"
      exit 99
      ;;
    git)
      if [[ ${1:-} == apply && ${CHECKPOINT_REVIEW_TEST_MODE:-} == prepare ]]; then
        "$CHECKPOINT_REVIEW_TEST_REAL_GIT" "$@"
        printf 'preparation mutation\n' >>"$CHECKPOINT_REVIEW_TEST_REPO/unrelated.txt"
        exit
      fi
      exec "$CHECKPOINT_REVIEW_TEST_REAL_GIT" "$@"
      ;;
    pi)
      printf '%s\0' "$@" >"$CHECKPOINT_REVIEW_TEST_OUTPUT/args.$$.bin"
      effort=''
      previous=''
      for arg in "$@"; do
        [[ $previous != --thinking ]] || effort="$arg"
        previous="$arg"
      done
      case "${CHECKPOINT_REVIEW_TEST_MODE:-success}" in
        fail)
          if [[ $effort == high ]]; then exit 17; fi
          printf 'ready\n' >"$CHECKPOINT_REVIEW_TEST_READY"
          read -r <"$CHECKPOINT_REVIEW_TEST_RELEASE"
          ;;
        cancel)
          # A descendant in each reviewer group must stop on cancellation too.
          (
            printf 'descendant %s\n' "$BASHPID" >"$CHECKPOINT_REVIEW_TEST_READY"
            read -r <"$CHECKPOINT_REVIEW_TEST_RELEASE"
          ) &
          printf 'reviewer %s\n' "$$" >"$CHECKPOINT_REVIEW_TEST_READY"
          wait
          ;;
        mutate)
          printf 'reviewer mutation %s\n' "$$" >>"$CHECKPOINT_REVIEW_TEST_REPO/unrelated.txt"
          ;;
        mutate-hidden)
          printf 'hidden mutation\n' >"$CHECKPOINT_REVIEW_TEST_REPO/hidden.txt"
          ;;
        mutate-submodule)
          printf 'submodule mutation\n' >"$CHECKPOINT_REVIEW_TEST_REPO/sub/file.txt"
          ;;
        orphan-success | orphan-cancel)
          if [[ $effort == high ]]; then
            read -r <"$CHECKPOINT_REVIEW_TEST_RELEASE" &
            printf 'descendant %s\n' "$!" >"$CHECKPOINT_REVIEW_TEST_READY"
            printf 'reviewer %s\n' "$$" >"$CHECKPOINT_REVIEW_TEST_READY"
          elif [[ $CHECKPOINT_REVIEW_TEST_MODE == orphan-cancel ]]; then
            printf 'sibling %s\n' "$$" >"$CHECKPOINT_REVIEW_TEST_READY"
            read -r <"$CHECKPOINT_REVIEW_TEST_RELEASE"
          fi
          ;;
        symlink-target)
          printf 'outside mutation\n' >>"$CHECKPOINT_REVIEW_TEST_OUTSIDE"
          ;;
      esac
      printf 'Mock Pi completed: %s\n' "$effort"
      exit
      ;;
  esac
fi

export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null
unset GIT_CONFIG_COUNT GIT_CONFIG_PARAMETERS GIT_CONFIG GIT_TEMPLATE_DIR
root="$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
temp_root="$(mktemp -d)"
review_pid=''
cleanup() {
  if [[ -n $review_pid ]]; then
    kill -TERM "$review_pid" 2>/dev/null || true
    wait "$review_pid" 2>/dev/null || true
  fi
  rm -rf -- "$temp_root"
}
trap cleanup EXIT
trap 'printf "Failed at line %s\n" "$LINENO" >&2' ERR
repo="$temp_root/repo"
bin_dir="$temp_root/bin"
output_dir="$temp_root/output"
tmp_dir="$temp_root/tmp"
patch="$temp_root/approved.patch"
context="$temp_root/context.md"
mkdir -p "$repo" "$bin_dir" "$output_dir" "$tmp_dir"
for name in pi model-role git fd fdfind rg forbidden; do
  ln -s -- "$root/scripts/test-checkpoint-review" "$bin_dir/$name"
done

git -C "$repo" init --quiet
git -C "$repo" config user.email checkpoint-review-test@example.com
git -C "$repo" config user.name 'Checkpoint Review Test'
printf 'baseline\n' >"$repo/tracked.txt"
printf 'hidden baseline\n' >"$repo/hidden.txt"
mkdir "$repo/directory"
printf 'nested baseline\n' >"$repo/directory/file.txt"
git -C "$repo" add tracked.txt hidden.txt directory/file.txt
git -C "$repo" commit --quiet -m baseline
printf 'Requirements: approved edit only.\nNon-goals: unrelated cleanup.\nPrior decision: retain earlier work.\n' >"$context"
: >"$patch"
review_script="$root/bin/checkpoint-review"
base_env=(
  PATH="$bin_dir:$PATH" REVIEW_MODEL= TMPDIR="$tmp_dir"
  CHECKPOINT_REVIEW_TEST_MOCK=1 CHECKPOINT_REVIEW_TEST_OUTPUT="$output_dir"
  CHECKPOINT_REVIEW_TEST_REPO="$repo" CHECKPOINT_REVIEW_TEST_REAL_GIT="$(command -v git)"
  CHECKPOINT_REVIEW_TEST_READY="$temp_root/ready" CHECKPOINT_REVIEW_TEST_RELEASE="$temp_root/release"
)
required_reviews=(--review correctness high --review simplification medium)
review_args=(--repo "$repo" --patch "$patch" --context "$context" "${required_reviews[@]}")
# Relative input files resolve from the invocation directory, not the worktree.
cd "$temp_root"

clear_output() { find "$output_dir" -mindepth 1 -delete; }
expect_status() {
  local actual=0 expected="$1"
  shift
  "$@" >"$temp_root/stdout" 2>"$temp_root/stderr" || actual=$?
  if [[ $actual != "$expected" ]]; then
    printf 'Expected status %s, got %s\n' "$expected" "$actual" >&2
    cat "$temp_root/stdout" "$temp_root/stderr" >&2
    return 1
  fi
}
run() { env "${base_env[@]}" "$review_script" "$@"; }
assert_invocation_count() {
  local files=("$output_dir"/args.*.bin)
  [[ ${#files[@]} == "$1" ]]
}
reject() {
  clear_output
  expect_status 2 run "$@"
  assert_invocation_count 0
}
assert_arg_pair() {
  local file="$1" name="$2" value="$3" previous='' arg
  while IFS= read -r -d '' arg; do
    if [[ $previous == "$name" && $arg == "$value" ]]; then return 0; fi
    previous="$arg"
  done <"$file"
  return 1
}
summary_path() {
  local line
  while IFS= read -r line; do
    if [[ $line == 'Review output: '* ]]; then
      printf '%s/summary.txt\n' "${line#Review output: }"
      return
    fi
  done <"$temp_root/stdout"
  return 1
}
shopt -s nullglob

expect_status 0 "$review_script" --help
for omitted in repo patch context; do
  args=()
  for option in repo patch context; do
    [[ $option == "$omitted" ]] || args+=("--$option" "${!option}")
  done
  reject "${args[@]}" "${required_reviews[@]}"
done
reject --repo repo --patch "$patch" --context "$context" "${required_reviews[@]}"
reject --repo "$temp_root" --patch "$patch" --context "$context" "${required_reviews[@]}"
reject --repo "$repo" --patch "$patch" --context "$context" --review correctness low
for extra in '--review correctness low' '--review complexity high' '--review security ultra'; do
  read -r -a args <<<"$extra"
  reject "${review_args[@]}" "${args[@]}"
done
reject "${review_args[@]}" --patch "$patch"
reject "${review_args[@]}" --custom-review low ' '
reject "${review_args[@]}" --custom-review low custom --custom-review low duplicate
for dependency in all-fd rg; do
  expect_status 127 env "${base_env[@]}" CHECKPOINT_REVIEW_TEST_PREFLIGHT="$dependency" "$review_script" "${review_args[@]}"
  assert_invocation_count 0
done

# Empty input does not infer scope from either a clean or a dirty worktree.
for content in baseline earlier-dirty; do
  printf '%s\n' "$content" >"$repo/tracked.txt"
  expect_status 0 run "${review_args[@]}"
  assert_invocation_count 0
done

# The caller's baseline includes earlier dirty edits in the SAME file.
printf 'earlier-dirty\n' >"$repo/tracked.txt"
git -C "$repo" diff --no-ext-diff --no-textconv --binary >"$temp_root/earlier.patch"
printf 'approved\n' >"$repo/tracked.txt"
printf 'unrelated\n' >"$repo/unrelated.txt"
cat >"$patch" <<'EOF'
diff --git a/tracked.txt b/tracked.txt
--- a/tracked.txt
+++ b/tracked.txt
@@ -1 +1 @@
-earlier-dirty
+approved
EOF
expect_status 0 run --repo "$repo" --patch approved.patch --context context.md "${required_reviews[@]}"
assert_invocation_count 2
summary="$(summary_path)"
for args_file in "$output_dir"/args.*.bin; do
  mapfile -d '' -t args <"$args_file"
  for flag in --print --no-session --no-approve --no-extensions --no-skills --no-prompt-templates; do
    [[ " ${args[*]} " == *" $flag "* ]]
  done
  for flag in --no-context-files --extension; do [[ " ${args[*]} " != *" $flag "* ]]; done
  assert_arg_pair "$args_file" --model openai-codex/fixture-deep
  assert_arg_pair "$args_file" --tools read,grep,find
  attachments=()
  for arg in "${args[@]}"; do [[ $arg != @* ]] || attachments+=("${arg#@}"); done
  [[ ${#attachments[@]} == 2 ]]
  cmp "$patch" "${attachments[0]}"
  cmp "$context" "${attachments[1]}"
  [[ $(stat -c %a "${attachments[0]}") == 400 && $(stat -c %a "${attachments[1]}") == 400 ]]
done
for receipt in 'Model argument: openai-codex/fixture-deep' 'correctness=high simplification=medium' 'Start UTC:' 'End UTC:' 'Worktree before:' 'Worktree prepared:' 'Worktree after:' 'Exit status: 0'; do
  grep -F "$receipt" "$summary" >/dev/null
done
for input in "$patch" "$context"; do grep -F "$(git hash-object --no-filters "$input")" "$summary" >/dev/null; done
[[ $(stat -c %a "${summary%/*}") == 700 ]]

# All options and effort values share one dispatch test, not five repeated runs.
clear_output
expect_status 0 env "${base_env[@]}" REVIEW_MODEL=example/custom-model "$review_script" "${review_args[@]}" \
  --review test-reduction low --review security xhigh --review test-gaps max \
  --review api-compat medium --review concurrency high --review policy low --custom-review max 'Check the custom contract.'
assert_invocation_count 9
summary="$(summary_path)"
for args_file in "$output_dir"/args.*.bin; do
  assert_arg_pair "$args_file" --model example/custom-model
done
for effort in low medium high xhigh max; do
  found=0
  for args_file in "$output_dir"/args.*.bin; do
    if assert_arg_pair "$args_file" --thinking "$effort"; then found=1; fi
  done
  [[ $found == 1 ]]
done
grep -F 'test-reduction-review status=0' "$summary" >/dev/null
grep -F 'custom-review status=0' "$summary" >/dev/null

# Reject stale, malformed, and unsafe patches without launching any reviewers.
cp "$patch" "$temp_root/valid.patch"
for invalid in stale malformed unsafe; do
  case "$invalid" in
    stale) cp "$temp_root/earlier.patch" "$patch" ;;
    malformed) printf 'not a patch\n' >"$patch" ;;
    unsafe) printf '%s\n' 'diff --git a/../outside b/../outside' '--- a/../outside' '+++ b/../outside' '@@ -1 +1 @@' '-before' '+after' >"$patch" ;;
  esac
  clear_output
  expect_status 1 run "${review_args[@]}"
  assert_invocation_count 0
done
cp "$temp_root/valid.patch" "$patch"
clear_output
expect_status 1 env "${base_env[@]}" CHECKPOINT_REVIEW_TEST_MODE=prepare "$review_script" "${review_args[@]}"
assert_invocation_count 0

# Fingerprinting must neither execute diff helpers nor read symlink targets.
git -C "$repo" config diff.external "$bin_dir/forbidden"
git -C "$repo" config diff.fixture.textconv "$bin_dir/forbidden"
printf 'tracked.txt diff=fixture\n' >"$repo/.gitattributes"
printf 'outside\n' >"$temp_root/outside"
ln -s "$temp_root/outside" "$repo/link"
expect_status 0 env "${base_env[@]}" CHECKPOINT_REVIEW_TEST_MODE=symlink-target \
  CHECKPOINT_REVIEW_TEST_OUTSIDE="$temp_root/outside" "$review_script" "${review_args[@]}"
[[ ! -e $output_dir/helper-ran ]]
mv "$repo/directory" "$temp_root/outside-directory"
ln -s "$temp_root/outside-directory" "$repo/directory"
expect_status 0 env "${base_env[@]}" CHECKPOINT_REVIEW_TEST_MODE=symlink-target \
  CHECKPOINT_REVIEW_TEST_OUTSIDE="$temp_root/outside-directory/file.txt" "$review_script" "${review_args[@]}"
[[ $(<"$temp_root/outside-directory/file.txt") == *'outside mutation'* ]]
rm "$repo/directory"
mv "$temp_root/outside-directory" "$repo/directory"
printf 'nested baseline\n' >"$repo/directory/file.txt"
expect_status 1 env "${base_env[@]}" CHECKPOINT_REVIEW_TEST_MODE=mutate "$review_script" "${review_args[@]}"
summary="$(summary_path)"
grep -F 'Worktree after:' "$summary" >/dev/null

# Git visibility flags must not hide changes to tracked bytes.
for flag in assume-unchanged skip-worktree; do
  git -C "$repo" update-index "--$flag" hidden.txt
  before_flags="$(git -C "$repo" ls-files -v hidden.txt)"
  expect_status 1 env "${base_env[@]}" CHECKPOINT_REVIEW_TEST_MODE=mutate-hidden "$review_script" "${review_args[@]}"
  [[ $(git -C "$repo" ls-files -v hidden.txt) == "$before_flags" ]]
  [[ $(<"$repo/hidden.txt") == 'hidden mutation' ]]
  git -C "$repo" update-index "--no-$flag" hidden.txt
  printf 'hidden baseline\n' >"$repo/hidden.txt"
done

# A submodule that was already dirty must retain a content-sensitive fingerprint.
sub_source="$temp_root/sub-source"
sub_repo="$temp_root/sub-repo"
for fixture in "$sub_source" "$sub_repo"; do
  git init --quiet "$fixture"
  git -C "$fixture" config user.email checkpoint-review-test@example.com
  git -C "$fixture" config user.name 'Checkpoint Review Test'
  printf 'baseline\n' >"$fixture/file.txt"
  git -C "$fixture" add file.txt
  git -C "$fixture" commit --quiet -m baseline
done
git -C "$sub_repo" -c protocol.file.allow=always submodule add --quiet "$sub_source" sub
git -C "$sub_repo" commit --quiet -m submodule
printf 'approved\n' >"$sub_repo/file.txt"
git -C "$sub_repo" diff --binary --no-ext-diff --no-textconv -- file.txt >"$temp_root/sub.patch"
printf 'earlier dirty\n' >"$sub_repo/sub/file.txt"
expect_status 1 env "${base_env[@]}" CHECKPOINT_REVIEW_TEST_REPO="$sub_repo" CHECKPOINT_REVIEW_TEST_MODE=mutate-submodule \
  "$review_script" --repo "$sub_repo" --patch "$temp_root/sub.patch" --context "$context" "${required_reviews[@]}"
[[ $(<"$sub_repo/sub/file.txt") == 'submodule mutation' ]]

# A failed reviewer cannot end the command before its sibling settles.
mkfifo "$temp_root/ready" "$temp_root/release"
exec {ready_fd}<>"$temp_root/ready" {release_fd}<>"$temp_root/release"
clear_output
env "${base_env[@]}" CHECKPOINT_REVIEW_TEST_MODE=fail "$review_script" "${review_args[@]}" >"$temp_root/stdout" 2>"$temp_root/stderr" &
review_pid=$!
read -r -u "$ready_fd"
kill -0 "$review_pid"
printf 'release\n' >&"$release_fd"
status=0
wait "$review_pid" || status=$?
review_pid=''
[[ $status == 1 ]]
summary="$(summary_path)"
grep -F 'correctness-review status=17' "$summary" >/dev/null
grep -F 'simplification-review status=0' "$summary" >/dev/null
grep -F 'Mock Pi completed: medium' "${summary%/*}/report.md" >/dev/null

# Cancellation kills both owned reviewer groups, including descendants, and waits.
clear_output
env "${base_env[@]}" CHECKPOINT_REVIEW_TEST_MODE=cancel "$review_script" "${review_args[@]}" >"$temp_root/stdout" 2>"$temp_root/stderr" &
review_pid=$!
children=()
for _ in 1 2 3 4; do
  read -r -u "$ready_fd" kind pid
  [[ $kind == reviewer || $kind == descendant ]]
  children+=("$pid")
done
kill -TERM "$review_pid"
status=0
wait "$review_pid" || status=$?
review_pid=''
[[ $status == 143 ]]
for pid in "${children[@]}"; do
  state="$(ps -o stat= -p "$pid" || true)"
  [[ -z $state || $state == Z* ]]
done
grep -F 'Exit status: 143' "$(summary_path)" >/dev/null
# A completed reviewer cannot leave descendants behind on success or cancellation.
for mode in orphan-success orphan-cancel; do
  clear_output
  env "${base_env[@]}" CHECKPOINT_REVIEW_TEST_MODE="$mode" "$review_script" "${review_args[@]}" >"$temp_root/stdout" 2>"$temp_root/stderr" &
  review_pid=$!
  children=()
  leader=''
  events=2
  [[ $mode != orphan-cancel ]] || events=3
  for ((i = 0; i < events; i++)); do
    read -r -u "$ready_fd" kind pid
    children+=("$pid")
    [[ $kind != reviewer ]] || leader="$pid"
  done
  if [[ $mode == orphan-cancel ]]; then
    tail --pid="$leader" -f /dev/null
    kill -TERM "$review_pid"
  fi
  status=0
  wait "$review_pid" || status=$?
  review_pid=''
  expected=0
  [[ $mode != orphan-cancel ]] || expected=143
  [[ $status == "$expected" ]]
  for pid in "${children[@]}"; do
    state="$(ps -o stat= -p "$pid" || true)"
    [[ -z $state || $state == Z* ]]
  done
done
exec {ready_fd}>&- {release_fd}>&-

# Clean committed scope and unborn repositories also use the caller's patch.
git -C "$repo" add tracked.txt
git -C "$repo" commit --quiet -m approved
rm -- "$repo/unrelated.txt" "$repo/.gitattributes" "$repo/link"
[[ -z $(git -C "$repo" status --porcelain) ]]
clear_output
expect_status 0 run "${review_args[@]}"
assert_invocation_count 2
unborn="$temp_root/unborn"
git init --quiet "$unborn"
printf 'new\n' >"$unborn/new.txt"
git -C "$unborn" add new.txt
git -C "$unborn" diff --cached --no-ext-diff --no-textconv --binary >"$patch"
clear_output
expect_status 0 run --repo "$unborn" --patch "$patch" --context "$context" "${required_reviews[@]}"
assert_invocation_count 2
printf 'Checkpoint review tests passed.\n'
