#!/usr/bin/env python3
"""Offline protection for durable mailbox state and uncertain sends."""

from copy import deepcopy
import importlib.machinery
import importlib.util
import io
from pathlib import Path
import tempfile
import unittest
from unittest.mock import patch


loader = importlib.machinery.SourceFileLoader("mailbox", str(Path(__file__).resolve().parent.parent / "bin/agent-mailbox"))
spec = importlib.util.spec_from_loader(loader.name, loader)
mailbox = importlib.util.module_from_spec(spec)
loader.exec_module(mailbox)
INBOX, DRAFT, THREAD, EMAIL, OTHER = [f"00000000-0000-4000-8000-{i:012d}" for i in range(1, 6)]


class MailboxTests(unittest.TestCase):
    def setUp(self):
        self.temporary = tempfile.TemporaryDirectory(dir="/tmp")
        self.addCleanup(self.temporary.cleanup)
        self.config = {"inbox_id": INBOX, "state_dir": self.temporary.name + "/state", "download_timeout_seconds": 1}
        self.draft = dict(id=DRAFT, type="standalone", to=["reader@example.test"], cc=[], bcc=[],
                          subject="Synthetic", text="Reviewed body", html=None, thread_id=None,
                          reply_to_email_id=None, email_id=None, updated_at="synthetic-version-1")
        self.calls = []
        self.failure = None

        def cli(config, *args, help_text=False):
            self.calls.append(args)
            if help_text:
                return "--idempotency-key --folders"
            if args[:2] == ("inboxes", "get"):
                return dict(id=INBOX, email_address="mailbox@example.test", from_name="Synthetic sender")
            if args[:3] == ("inboxes", "drafts", "get"):
                return deepcopy(self.draft)
            if args[:3] == ("inboxes", "drafts", "send"):
                with mailbox.sqlite3.connect(Path(config["state_dir"]) / "state.sqlite3") as db:
                    assert db.execute("SELECT status FROM intents").fetchone()[0] == "attempting"
                if self.failure:
                    raise self.failure
                return dict(id=DRAFT, thread_id=THREAD, email_id=EMAIL)
            raise AssertionError(args)

        mocking = patch.object(mailbox, "cli", cli)
        mocking.start()
        self.addCleanup(mocking.stop)

    def test_cli_rejects_invalid_config_before_state_or_provider_work(self):
        root = Path(self.temporary.name)
        config_file = root / "config.json"
        marker = root / "provider-called"
        provider = root / "resend"
        provider.write_text(f"#!/bin/sh\nprintf called > '{marker}'\nexit 99\n")
        provider.chmod(0o755)
        environment = {**mailbox.os.environ, "PATH": str(root) + mailbox.os.pathsep + mailbox.os.environ["PATH"]}
        minimal = {"inbox_id": INBOX, "state_dir": self.config["state_dir"]}
        cases = [
            ([], "pending", "JSON object"),
            ({**minimal, "inbox_id": 7}, "pending", "inbox_id"),
            ({**minimal, "state_dir": None}, "pending", "state_dir"),
            ({**minimal, "profile": False}, "pending", "profile"),
            (minimal, "export", "download_timeout_seconds"),
            ({**minimal, "download_timeout_seconds": []}, "export", "download_timeout_seconds"),
            ({**minimal, "download_timeout_seconds": "NaN"}, "export", "download_timeout_seconds"),
            ({**minimal, "download_timeout_seconds": 0}, "export", "download_timeout_seconds"),
            ({**minimal, "download_timeout_seconds": True}, "export", "download_timeout_seconds"),
            (self.config, "run", "archive_dir"),
            ({**self.config, "archive_dir": str(root / "archives"), "archive_copy": "invalid"}, "run", "archive_copy"),
        ]
        for config, command, error in cases:
            with self.subTest(command=command, config=config):
                config_file.write_text(mailbox.encode(config))
                arguments = [command] + (["--output", str(root / "archive")] if command == "export" else [])
                result = mailbox.subprocess.run([mailbox.sys.executable, "-B", mailbox.__file__,
                                                  "--config", str(config_file), *arguments],
                                                 env=environment, capture_output=True, text=True)
                self.assertEqual(result.returncode, 1)
                self.assertIn(error, mailbox.json.loads(result.stderr)["error"])
                self.assertFalse(Path(self.config["state_dir"]).exists())
                self.assertFalse(marker.exists())
        config_file.write_text(mailbox.encode(minimal))
        result = mailbox.subprocess.run([mailbox.sys.executable, "-B", mailbox.__file__,
                                          "--config", str(config_file), "pending"],
                                         env=environment, capture_output=True, text=True, check=True)
        self.assertEqual(mailbox.json.loads(result.stdout), {"pending": []})
        self.assertFalse(marker.exists())

    def test_review_send_and_restart_do_not_duplicate(self):
        with mailbox.state(self.config) as db:
            mailbox.review(self.config, db, DRAFT, "logical-action")
            self.assertEqual(mailbox.send(self.config, db, "logical-action", mailbox.digest(mailbox.snapshot(self.config, DRAFT)))["status"], "sent")
        with mailbox.state(self.config) as db:
            mailbox.send(self.config, db, "logical-action", mailbox.digest(mailbox.snapshot(self.config, DRAFT)))
        sends = [call for call in self.calls if call[:3] == ("inboxes", "drafts", "send") and "--help" not in call]
        self.assertEqual(len(sends), 1)
        self.assertIn("--idempotency-key", sends[0])

    def test_ui_edit_blocks_send_and_can_be_reviewed_again(self):
        with mailbox.state(self.config) as db:
            first = mailbox.review(self.config, db, DRAFT, "action")["sha256"]
            self.draft["cc"] = ["colleague@example.test"]
            with self.assertRaisesRegex(ValueError, "changed"):
                mailbox.send(self.config, db, "action", first)
            second = mailbox.review(self.config, db, DRAFT, "action")["sha256"]
            with self.assertRaisesRegex(ValueError, "Stored review changed"):
                mailbox.send(self.config, db, "action", first)
            with self.assertRaises(mailbox.sqlite3.IntegrityError):
                mailbox.review(self.config, db, DRAFT, "another-key")
            mailbox.send(self.config, db, "action", second)

    def test_timeout_and_process_death_block_retry(self):
        for failure in (RuntimeError("timeout"), KeyboardInterrupt()):
            with self.subTest(failure=type(failure).__name__), tempfile.TemporaryDirectory(dir="/tmp") as directory:
                config = {**self.config, "state_dir": directory + "/state"}
                with mailbox.state(config) as db:
                    mailbox.review(config, db, DRAFT, "action")
                    self.failure = failure
                    with self.assertRaises((RuntimeError, KeyboardInterrupt)):
                        mailbox.send(config, db, "action", mailbox.digest(mailbox.snapshot(config, DRAFT)))
                with mailbox.state(config) as db:
                    with self.assertRaisesRegex(ValueError, "uncertain"):
                        mailbox.send(config, db, "action", mailbox.digest(mailbox.snapshot(config, DRAFT)))
                    self.assertNotEqual(mailbox.reconcile(config, db, "action")["status"], "sent")
                    self.draft.update(email_id=EMAIL, thread_id=THREAD)
                    self.assertEqual(mailbox.reconcile(config, db, "action")["status"], "sent")
                self.draft.update(email_id=None, thread_id=None)

    def test_discovery_resumes_message_cursor_and_preserves_pending(self):
        failed = False
        calls = []

        def pages(config, args, cursor=None):
            nonlocal failed
            calls.append((args, cursor))
            if args[2] == "list":
                return [{"id": THREAD}], None
            if cursor is None:
                return [{"id": EMAIL, "text": "Untrusted synthetic inbound"}], EMAIL
            if not failed:
                failed = True
                raise RuntimeError("interrupted")
            return [{"id": OTHER, "text": "Second page"}], None

        with patch.object(mailbox, "page", pages):
            with mailbox.state(self.config) as db:
                with self.assertRaises(RuntimeError):
                    mailbox.poll(self.config, db)
                self.assertEqual(len(mailbox.pending(db)), 1)
                mailbox.review(self.config, db, DRAFT, "preserved-intent")
            with mailbox.state(self.config) as db:
                mailbox.poll(self.config, db)
                self.assertEqual(calls[3][1], EMAIL)
                self.assertEqual(len(mailbox.pending(db)), 2)
                with db:
                    db.execute("UPDATE messages SET acknowledged=1 WHERE id=?", (EMAIL,))
                mailbox.poll(self.config, db)
                self.assertEqual(len(mailbox.pending(db)), 1)
                with db:
                    db.execute("INSERT INTO scan VALUES (?)", ('{"deleted-thread":"synthetic"}',))
            config_file = Path(self.temporary.name) / "config.json"
            config_file.write_text(mailbox.encode(self.config))
            mailbox.subprocess.run(["python3", "-B", str(Path(mailbox.__file__)), "--config", str(config_file),
                                    "restart-discovery"], check=True, capture_output=True)
            with mailbox.state(self.config) as db:
                self.assertIsNone(db.execute("SELECT value FROM scan").fetchone())
                self.assertEqual(len(mailbox.pending(db)), 1)
                self.assertEqual(mailbox.intent(db, "preserved-intent")[2], "reviewed")

    def test_state_cannot_be_shared_by_another_inbox(self):
        with mailbox.state(self.config):
            pass
        with self.assertRaisesRegex(ValueError, "another inbox"):
            with mailbox.state({**self.config, "inbox_id": OTHER}):
                pass

    def test_state_symlink_is_rejected_without_touching_target(self):
        target = Path(self.temporary.name) / "unrelated"
        target.write_text("Preserve this file")
        before = target.stat().st_mode
        directory = Path(self.config["state_dir"])
        directory.mkdir()
        for name in ("lock", "state.sqlite3"):
            with self.subTest(name=name):
                link = directory / name
                link.symlink_to(target)
                with self.assertRaisesRegex(ValueError, "never symlinks"):
                    with mailbox.state(self.config):
                        pass
                self.assertEqual(target.read_text(), "Preserve this file")
                self.assertEqual(target.stat().st_mode, before)
                link.unlink()

    def test_overlap_fails_without_waiting(self):
        with mailbox.state(self.config):
            with self.assertRaises(BlockingIOError):
                with mailbox.state(self.config):
                    self.fail("Overlapping invocation acquired the lock")

    def test_export_pages_downloads_and_verification(self):
        attachment_ids = [f"00000000-0000-4000-8000-{i:012d}" for i in (6, 7)]
        second_thread = "00000000-0000-4000-8000-000000000008"
        email = dict(id=EMAIL, direction="inbound", message_id="<synthetic@example.test>",
                     text="Exact authored body\n", html=None,
                     attachments=[dict(id=value) for value in attachment_ids])
        outbound = {**email, "id": OTHER, "direction": "outbound", "attachments": [],
                    "message_id": "<synthetic-outbound@example.test>"}
        downloaded = {}
        fail_attachment = False

        def cli(config, *args, help_text=False):
            if args[:2] == ("inboxes", "get"):
                return dict(id=INBOX)
            if args[:3] == ("inboxes", "labels", "list"):
                return dict(object="list", data=[])
            cursor = args[args.index("--after") + 1] if "--after" in args else None
            if args[:3] == ("inboxes", "threads", "list"):
                self.assertIn("trash", args)
                rows = [{"id": THREAD}] if cursor is None else [{"id": second_thread}]
                return dict(data=rows, has_more=cursor is None)
            if args[:4] == ("inboxes", "threads", "emails", "list"):
                rows = [email] if cursor is None else [outbound]
                return dict(data=rows, has_more=cursor is None)
            if args[:3] == ("inboxes", "drafts", "list"):
                return dict(data=[{"id": DRAFT}], has_more=False)
            if args[:3] == ("inboxes", "drafts", "get"):
                return self.draft
            if args[:3] == ("emails", "receiving", "get"):
                return {**email, "headers": {"x-synthetic": "preserved"},
                        "raw": {"download_url": "https://downloads.example.test/raw?synthetic-secret"}}
            if args[:2] == ("emails", "get"):
                return {**outbound, "last_event": "delivered"}
            if args[:3] == ("emails", "receiving", "attachments"):
                index = 0 if cursor is None else 1
                if fail_attachment and index:
                    raise RuntimeError("Attachment page unavailable")
                return dict(data=[dict(id=attachment_ids[index], size=3,
                                       filename="../../untrusted.sh",
                                       download_url=f"https://downloads.example.test/{index}?synthetic-secret")],
                            has_more=index == 0)
            if args[:2] == ("emails", "attachments"):
                return dict(data=[], has_more=False)
            raise AssertionError(args)

        def download(url, path, size=None, timeout=None):
            content = b"Raw synthetic MIME\r\n" if "/raw" in url else b"abc"
            path.write_bytes(content)
            downloaded[str(path)] = content
            if size is not None:
                self.assertEqual(len(content), size)

        with patch.object(mailbox, "cli", cli), patch.object(mailbox, "download", download):
            destination = Path(self.temporary.name) / "archive"
            result = mailbox.export(self.config, destination)
            self.assertTrue(result["integrity_verified"] and result["enumeration_complete"] and result["content_complete"])
            self.assertEqual(len(downloaded), 3)
            self.assertTrue(any("Outbound" in item for item in result["limits"]))
            self.assertEqual((destination / f"emails/{EMAIL}/body.txt").read_text(), email["text"])
            manifest = mailbox.json.loads((destination / "manifest.json").read_text())
            for record in manifest["files"]:
                if record["path"].endswith(".json"):
                    saved = (destination / record["path"]).read_text()
                    self.assertNotIn("download_url", saved)
                    self.assertNotIn("synthetic-secret", saved)
            raw = destination / f"emails/{EMAIL}/message.eml"
            raw.write_bytes(b"corruption")
            with self.assertRaisesRegex(ValueError, "verification failed"):
                mailbox.verify(destination)
            fail_attachment = True
            partial = mailbox.export(self.config, Path(self.temporary.name) / "partial")
            self.assertTrue(partial["integrity_verified"])
            self.assertFalse(partial["content_complete"])
            self.assertTrue(partial["gaps"])

    def test_verify_rejects_unsafe_archives(self):
        root = Path(self.temporary.name) / "archive"
        root.mkdir()
        manifest = root / "manifest.json"
        valid = dict(format=1, files=[], enumeration_complete=False, content_complete=False, gaps=[], limits=[])
        manifest.write_text(mailbox.encode(valid))
        command = [mailbox.sys.executable, "-B", mailbox.__file__, "verify", str(root)]
        result = mailbox.subprocess.run(command, capture_output=True, text=True, check=True)
        receipt = mailbox.json.loads(result.stdout)
        self.assertTrue(receipt["integrity_verified"])
        self.assertFalse(receipt["content_complete"])
        manifest.write_text(mailbox.encode({**valid, "files": [
            {"path": "../unrelated", "bytes": 0, "sha256": "untrusted"}]}))
        with self.assertRaisesRegex(ValueError, "Unsafe"):
            mailbox.verify(root)
        for malformed in [[], {**valid, "format": True}, {**valid, "files": None},
                          {**valid, "gaps": None}, {**valid, "enumeration_complete": "false"},
                          {**valid, "files": [None]}, {**valid, "files": [{"path": None}]}]:
            with self.subTest(manifest=malformed):
                manifest.write_text(mailbox.encode(malformed))
                result = mailbox.subprocess.run(command, capture_output=True, text=True)
                self.assertEqual(result.returncode, 1)
                self.assertIn("manifest", mailbox.json.loads(result.stderr)["error"].lower())
        manifest.unlink()
        mailbox.os.mkfifo(manifest)
        with patch.object(Path, "read_text", side_effect=AssertionError("Must not read a non-regular manifest")):
            with self.assertRaisesRegex(ValueError, "regular file"):
                mailbox.verify(root)
        manifest.unlink()
        manifest.write_text(mailbox.encode(valid))
        outside = Path(self.temporary.name) / "outside"
        outside.mkdir()
        entry = root / "unlisted"
        for kind in ("directory-link", "fifo", "file"):
            with self.subTest(entry=kind):
                if kind == "directory-link":
                    entry.symlink_to(outside, target_is_directory=True)
                elif kind == "fifo":
                    mailbox.os.mkfifo(entry)
                else:
                    entry.write_text("Unlisted bytes")
                with self.assertRaisesRegex(ValueError, "Archive"):
                    mailbox.verify(root)
                entry.unlink()
        with patch.object(mailbox.os, "scandir", side_effect=PermissionError("Unreadable archive directory")):
            with self.assertRaises(PermissionError):
                mailbox.verify(root)

    def test_download_rejects_private_hosts(self):
        root = Path(self.temporary.name)
        with self.assertRaisesRegex(ValueError, "HTTPS"):
            mailbox.download("http://localhost/secret", root / "bytes")
        addresses = [(mailbox.socket.AF_INET, mailbox.socket.SOCK_STREAM, 6, "", ("127.0.0.1", 443))]
        with patch.object(mailbox.socket, "getaddrinfo", return_value=addresses):
            with self.assertRaisesRegex(ValueError, "public addresses"):
                mailbox.download("https://downloads.example.test/secret", root / "bytes")

    def test_download_rejects_truncated_bytes_and_preserves_existing_files(self):
        root = Path(self.temporary.name)
        response = io.BytesIO(b"abc")
        response.status = 200
        response.getheader = lambda name: "4"
        connection = unittest.mock.Mock()
        connection.getresponse.return_value = response
        addresses = [(mailbox.socket.AF_INET, mailbox.socket.SOCK_STREAM, 6, "", ("93.184.216.34", 443))]
        with patch.object(mailbox.socket, "getaddrinfo", return_value=addresses), \
                patch.object(mailbox.socket, "create_connection") as connect, \
                patch.object(mailbox.ssl, "create_default_context"), \
                patch.object(mailbox.http.client, "HTTPSConnection", return_value=connection):
            target = root / "download"
            with self.assertRaisesRegex(RuntimeError, "Download failed"):
                mailbox.download("https://downloads.example.test/raw", target, timeout=1)
            self.assertFalse(target.exists())
            connect.assert_called_with(("93.184.216.34", 443), timeout=1)
            target.write_bytes(b"Preserve existing bytes")
            with self.assertRaises(RuntimeError):
                mailbox.download("https://downloads.example.test/raw", target, timeout=1)
            self.assertEqual(target.read_bytes(), b"Preserve existing bytes")

    def test_run_reports_counts_and_copy_is_optional(self):
        self.config["archive_dir"] = self.temporary.name + "/archives"
        result = dict(integrity_verified=True, enumeration_complete=True, content_complete=True)
        with patch.object(mailbox, "doctor"), \
                patch.object(mailbox, "poll", return_value={"pending": [{"private_body": "Do not log"}]}), \
                patch.object(mailbox, "export", return_value=result), \
                patch.object(mailbox.subprocess, "run") as copied:
            with mailbox.state(self.config) as db:
                self.assertEqual(mailbox.run(self.config, db)["pending_count"], 1)
                copied.assert_not_called()
                self.config["archive_copy"] = "backup-host:/private/archive/"
                copied.return_value.returncode = 0
                receipt = mailbox.run(self.config, db)
                self.assertTrue(receipt["copy"]["transferred"])
                self.assertNotIn("Do not log", mailbox.encode(receipt))
                self.assertIn("--protect-args", copied.call_args.args[0])
                local = Path(self.temporary.name) / "backup:local"
                local.mkdir()
                self.assertEqual(mailbox.copy_destination(str(local) + "/"), str(local.resolve()) + "/")
                with patch.dict(mailbox.os.environ, {"HOME": self.temporary.name}):
                    self.assertEqual(mailbox.copy_destination("~/"), self.temporary.name + "/")
                checkout = Path(self.temporary.name) / "checkout"
                (checkout / ".git").mkdir(parents=True)
                (checkout / ".git/HEAD").write_text("ref: refs/heads/main")
                forbidden = checkout / "backup:local"
                forbidden.mkdir()
                with self.assertRaisesRegex(ValueError, "outside Git"):
                    mailbox.copy_destination(str(forbidden) + "/")

    def test_download_timeout_and_dns_fallback(self):
        addresses = [(mailbox.socket.AF_INET, mailbox.socket.SOCK_STREAM, 6, "", (host, 443))
                     for host in ("93.184.216.34", "93.184.216.35")]
        response = io.BytesIO(b"abc")
        response.status = 200
        response.getheader = lambda name: "3"
        connection = unittest.mock.Mock()
        connection.getresponse.return_value = response
        target = Path(self.temporary.name) / "bytes"
        with patch.object(mailbox.socket, "getaddrinfo", return_value=addresses), \
                patch.object(mailbox.socket, "create_connection", side_effect=[OSError("unreachable"), unittest.mock.Mock()]) as connect, \
                patch.object(mailbox.ssl, "create_default_context"), \
                patch.object(mailbox.http.client, "HTTPSConnection", return_value=connection):
            mailbox.download("https://downloads.example.test/raw", target, timeout=1)
            self.assertEqual(target.read_bytes(), b"abc")
            self.assertEqual(connect.call_count, 2)
        target.unlink()
        with patch.object(mailbox.socket, "getaddrinfo", return_value=addresses), \
                patch.object(mailbox.socket, "create_connection"), \
                patch.object(mailbox.ssl, "create_default_context"), \
                patch.object(mailbox.http.client, "HTTPSConnection", return_value=connection):
            connection.getresponse.side_effect = TimeoutError("stalled response")
            with self.assertRaisesRegex(RuntimeError, "Download failed"):
                mailbox.download("https://downloads.example.test/raw", target, timeout=1)
            self.assertFalse(target.exists())


if __name__ == "__main__":
    unittest.main()
