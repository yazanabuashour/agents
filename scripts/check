#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
shell_files=(bin/checkpoint-review scripts/check scripts/test-checkpoint-review)
for script in "${shell_files[@]}"; do bash -n "$script"; done
shellcheck -x "${shell_files[@]}"
shfmt -d -i 2 -ci "${shell_files[@]}"
python3 -B scripts/check-profile
python3 -B scripts/test-profile
python3 -B scripts/test-install
python3 -B scripts/test-agent-mailbox
python3 -B scripts/test-rust-baseline
scripts/test-checkpoint-review
git diff --check
git diff --cached --check
