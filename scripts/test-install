#!/usr/bin/env python3
import os
from pathlib import Path
import subprocess
import tempfile

root = Path(__file__).resolve().parent.parent
with tempfile.TemporaryDirectory() as temporary:
    home = Path(temporary) / "home"
    skills = home / ".agents/skills"
    skills.mkdir(parents=True)
    baseline = home / ".agents/AGENTS.md"
    baseline.write_text("Earlier personal policy\n")
    outside = Path(temporary) / "application-skill"
    outside.mkdir()
    (outside / "SKILL.md").write_text("Application-owned skill\n")
    (skills / "omarchy").symlink_to(outside, target_is_directory=True)
    (skills / "siftwire").mkdir()
    application = skills / "siftwire/SKILL.md"
    application.write_text("Version-matched application policy\n")
    environment = {**os.environ, "HOME": str(home), "XDG_STATE_HOME": str(home / ".local/state")}

    def run(*arguments):
        return subprocess.run([str(root / "scripts/install-local"), *arguments], env=environment,
                              capture_output=True, text=True, check=True)

    preview = run()
    assert str(baseline) in preview.stdout
    assert baseline.read_text() == "Earlier personal policy\n"
    assert not (home / ".local/bin/checkpoint-review").exists()
    installed = run("--apply")
    backups = list((home / ".local/state/agents/backups").glob("install-*"))
    assert len(backups) == 1
    assert (backups[0] / ".agents/AGENTS.md").read_text() == "Earlier personal policy\n"
    assert "Backups:" in installed.stdout
    assert baseline.read_bytes() == (root / "instructions/AGENTS.md").read_bytes()
    assert baseline.stat().st_mode & 0o777 == 0o600
    assert (home / ".local/bin/checkpoint-review").read_bytes() == (root / "bin/checkpoint-review").read_bytes()
    assert (home / ".local/bin/checkpoint-review").stat().st_mode & 0o777 == 0o755
    for source in (root / "skills").rglob("*"):
        if source.is_file():
            assert (home / ".agents" / source.relative_to(root)).read_bytes() == source.read_bytes()
    assert application.read_text() == "Version-matched application policy\n"
    assert (skills / "omarchy").is_symlink()
    assert (outside / "SKILL.md").read_text() == "Application-owned skill\n"
    assert not (home / ".claude").exists()
    assert run().stdout == "Preview only. Run scripts/install-local --apply to install these files.\n"
    assert run("--apply").stdout == "Personal agent files already match.\n"
    baseline.unlink()
    baseline.symlink_to(outside / "SKILL.md")
    refused = subprocess.run([str(root / "scripts/install-local"), "--apply"], env=environment,
                             capture_output=True, text=True)
    assert refused.returncode != 0 and "Refusing to write through a symlink" in refused.stderr
    assert (outside / "SKILL.md").read_text() == "Application-owned skill\n"
print("Personal installer tests passed.")
