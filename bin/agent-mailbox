#!/usr/bin/env python3
"""Durable discovery and reviewed native drafts using the official Resend CLI."""

import argparse
from contextlib import contextmanager
from datetime import datetime, timezone
import fcntl
import hashlib
import http.client
import ipaddress
import json
import math
import os
from pathlib import Path
import re
import sqlite3
import stat
import shutil
import socket
import ssl
import subprocess
import sys
import uuid
import urllib.parse


def encode(value):
    return json.dumps(value, sort_keys=True, ensure_ascii=False, separators=(",", ":"))


def digest(value):
    return hashlib.sha256(encode(value).encode()).hexdigest()


def identifier(value):
    if not isinstance(value, str):
        raise ValueError("Expected a UUID string")
    return str(uuid.UUID(value))


def outside_git(path):
    path = Path(path).expanduser().resolve()
    if any((parent / ".git").is_file() or (parent / ".git/HEAD").is_file()
           for parent in (path, *path.parents)):
        raise ValueError("Config, state, and archives must be outside Git checkouts")
    return path


def cli(config, *args, help_text=False):
    command = ["resend", "--json"]
    if config.get("profile"):
        command += ["--profile", config["profile"]]
    result = subprocess.run(command + list(args), stdin=subprocess.DEVNULL,
                            capture_output=True, text=True, check=False)
    if result.returncode:
        raise RuntimeError(f"Resend command failed (exit {result.returncode}); inspect it privately")
    return result.stdout if help_text else json.loads(result.stdout)


def page(config, args, cursor=None):
    result = cli(config, *args, "--limit", "100", *(["--after", cursor] if cursor else []))
    if not isinstance(result.get("data"), list) or type(result.get("has_more")) is not bool:
        raise ValueError("Unexpected paginated response; refusing to mark discovery complete")
    rows = result["data"]
    for row in rows:
        identifier(row["id"])
    if result["has_more"] and (not rows or rows[-1]["id"] == cursor):
        raise ValueError("Pagination did not advance")
    return rows, rows[-1]["id"] if result["has_more"] else None


@contextmanager
def state(config):
    directory = outside_git(config["state_dir"])
    directory.mkdir(mode=0o700, parents=True, exist_ok=True)
    os.chmod(directory, 0o700)
    for name in ("lock", "state.sqlite3", "state.sqlite3-journal", "state.sqlite3-wal", "state.sqlite3-shm"):
        path = directory / name
        if path.is_symlink() or (path.exists() and not path.is_file()):
            raise ValueError("State files must be regular files, never symlinks")
        outside_git(path)
    descriptor = os.open(directory / "lock", os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
    with os.fdopen(descriptor, "a") as lock:
        if not stat.S_ISREG(os.fstat(lock.fileno()).st_mode):
            raise ValueError("State lock must be a regular file")
        os.fchmod(lock.fileno(), 0o600)
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        connection = sqlite3.connect(directory / "state.sqlite3")
        try:
            os.chmod(directory / "state.sqlite3", 0o600)
            connection.execute("PRAGMA synchronous=FULL")
            connection.executescript("""
                CREATE TABLE IF NOT EXISTS identity (value TEXT NOT NULL);
                CREATE TABLE IF NOT EXISTS messages
                    (id TEXT PRIMARY KEY, payload TEXT NOT NULL, acknowledged INTEGER DEFAULT 0);
                CREATE TABLE IF NOT EXISTS scan (value TEXT NOT NULL);
                CREATE TABLE IF NOT EXISTS intents
                    (key TEXT PRIMARY KEY, draft_id TEXT UNIQUE NOT NULL,
                     snapshot TEXT NOT NULL, status TEXT NOT NULL, result TEXT);
            """)
            identity = encode({"inbox_id": config["inbox_id"], "profile": config.get("profile")})
            existing = connection.execute("SELECT value FROM identity").fetchone()
            if existing and existing[0] != identity:
                raise ValueError("State belongs to another inbox/profile; use a separate state directory")
            if not existing:
                with connection:
                    connection.execute("INSERT INTO identity VALUES (?)", (identity,))
            yield connection
        finally:
            connection.close()


def pending(db):
    return [json.loads(row[0]) for row in db.execute(
        "SELECT payload FROM messages WHERE acknowledged=0 ORDER BY rowid")]


def poll(config, db):
    inbox = config["inbox_id"]
    row = db.execute("SELECT value FROM scan").fetchone()
    progress = json.loads(row[0]) if row else {"after": None, "threads": [], "next": None,
                                               "loaded": False, "email_after": None}
    progress.setdefault("thread_cursors", [])
    progress.setdefault("email_cursors", [])
    while True:
        if not progress["loaded"]:
            rows, following = page(config, ["inboxes", "threads", "list", "--inbox_id", inbox,
                                           "--folders", "inbox", "archive", "spam", "sent", "trash"],
                                   progress["after"])
            if following:
                if following in progress["thread_cursors"]:
                    raise ValueError("Discovery thread cursor repeated; restart discovery")
                progress["thread_cursors"].append(following)
            progress.update(threads=[r["id"] for r in rows], next=following, loaded=True)
        if progress["threads"]:
            thread = progress["threads"][0]
            rows, following = page(config, ["inboxes", "threads", "emails", "list", "--inbox_id", inbox,
                                           "--thread_id", thread], progress["email_after"])
            if following:
                if following in progress["email_cursors"]:
                    raise ValueError("Discovery email cursor repeated; restart discovery")
                progress["email_cursors"].append(following)
            with db:
                for message in rows:
                    db.execute("INSERT OR IGNORE INTO messages (id,payload) VALUES (?,?)",
                               (message["id"], encode({"thread_id": thread, "email": message})))
                progress["email_after"] = following
                if following is None:
                    progress["threads"].pop(0)
                    progress["email_cursors"] = []
                db.execute("DELETE FROM scan")
                db.execute("INSERT INTO scan VALUES (?)", (encode(progress),))
        elif progress["next"]:
            progress.update(after=progress["next"], loaded=False)
        else:
            with db:
                db.execute("DELETE FROM scan")
            return {"scan_complete": True, "pending": pending(db)}


def snapshot(config, draft_id):
    draft = cli(config, "inboxes", "drafts", "get", "--inbox_id", config["inbox_id"],
                "--draft_id", draft_id)
    inbox = cli(config, "inboxes", "get", config["inbox_id"])
    if draft.get("id") != draft_id or inbox.get("id") != config["inbox_id"]:
        raise ValueError("Unexpected draft or inbox identity")
    if draft.get("email_id"):
        raise ValueError("Draft already sent; reconcile the existing intent")
    for field in ("type", "to", "cc", "bcc", "subject", "text", "html", "thread_id", "reply_to_email_id"):
        if field not in draft:
            raise ValueError(f"Draft response missing {field}")
    return {"draft": draft, "sender": {field: inbox[field]
                                      for field in ("id", "email_address", "from_name")}}


def review(config, db, draft_id, key):
    if not key:
        raise ValueError("Logical send key must not be empty")
    current = snapshot(config, draft_id)
    old = db.execute("SELECT draft_id,status FROM intents WHERE key=?", (key,)).fetchone()
    if old:
        if old[1] != "reviewed" or old[0] != draft_id:
            raise ValueError("Intent already attempted or bound to another draft")
        with db:
            db.execute("UPDATE intents SET snapshot=? WHERE key=?", (encode(current), key))
    else:
        with db:
            db.execute("INSERT INTO intents VALUES (?,?,?,'reviewed',NULL)",
                       (key, draft_id, encode(current)))
    return {"key": key, "sha256": digest(current), "snapshot": current}


def intent(db, key):
    row = db.execute("SELECT draft_id,snapshot,status,result FROM intents WHERE key=?", (key,)).fetchone()
    if row is None:
        raise ValueError("Unknown logical send key; review the draft first")
    return row


def send(config, db, key, reviewed_sha256):
    draft_id, reviewed, status, result = intent(db, key)
    if digest(json.loads(reviewed)) != reviewed_sha256:
        raise ValueError("Stored review changed; inspect a fresh review before sending")
    if status == "sent":
        return {"status": status, "result": json.loads(result)}
    if status != "reviewed":
        raise ValueError("Attempt outcome is uncertain; reconcile, never blindly resend")
    help_output = cli(config, "inboxes", "drafts", "send", "--help", help_text=True)
    if "--idempotency-key" not in help_output:
        raise ValueError("Official CLI lacks draft idempotency; upgrade to a capable Inboxes preview")
    if encode(snapshot(config, draft_id)) != reviewed:
        raise ValueError("Draft or sender changed since review; review the same draft and key again")
    with db:
        db.execute("UPDATE intents SET status='attempting' WHERE key=?", (key,))
    request_key = digest({"inbox": config["inbox_id"], "key": key})
    try:
        result = cli(config, "inboxes", "drafts", "send", "--inbox_id", config["inbox_id"],
                     "--draft_id", draft_id, "--idempotency-key", request_key)
        if set(result) == {"id"}:
            email_id = identifier(result["id"])
            result = sent_draft(config, draft_id)
            if result is None or result["email_id"] != email_id:
                raise ValueError("Native draft did not confirm the send response email ID")
        if result.get("id") != draft_id or not result.get("email_id") or not result.get("thread_id"):
            raise ValueError("Unexpected send receipt")
        identifier(result["email_id"])
        identifier(result["thread_id"])
    except Exception:
        with db:
            db.execute("UPDATE intents SET status='uncertain' WHERE key=?", (key,))
        raise RuntimeError("Send outcome uncertain; use reconcile with the same key") from None
    with db:
        db.execute("UPDATE intents SET status='sent',result=? WHERE key=?", (encode(result), key))
    return {"status": "sent", "result": result}


def sent_draft(config, draft_id):
    draft = cli(config, "inboxes", "drafts", "get", "--inbox_id", config["inbox_id"],
                "--draft_id", draft_id)
    if draft.get("id") != draft_id:
        raise ValueError("Unexpected draft identity")
    if draft.get("email_id") and draft.get("thread_id"):
        identifier(draft["email_id"])
        identifier(draft["thread_id"])
        return {"id": draft_id, "email_id": draft["email_id"], "thread_id": draft["thread_id"],
                "evidence": "native draft reports sent; may have been sent in the human UI"}
    return None


def reconcile(config, db, key):
    draft_id, _, status, saved = intent(db, key)
    if status == "sent":
        return {"status": status, "result": json.loads(saved)}
    receipt = sent_draft(config, draft_id)
    if receipt is not None:
        with db:
            db.execute("UPDATE intents SET status='sent',result=? WHERE key=?", (encode(receipt), key))
        return {"status": "sent", "result": receipt}
    return {"status": status, "evidence": "No sent receipt; this does not prove the request failed"}


def doctor(config):
    version = cli(config, "--version", help_text=True)
    preview = re.search(r"2\.22\.0-preview-inboxes\.(\d+)", version)
    if preview and int(preview[1]) < 8:
        raise ValueError("This official preview has broken folder filters; upgrade before discovery/export")
    checks = {}
    for name, args, required in [
        ("draft_idempotency", ["inboxes", "drafts", "send", "--help"], "--idempotency-key"),
        ("folder_filter", ["inboxes", "threads", "list", "--help"], "--folders")]:
        checks[name] = required in cli(config, *args, help_text=True)
    inbox = cli(config, "inboxes", "get", config["inbox_id"])
    checks["inbox_access"] = inbox.get("id") == config["inbox_id"]
    if not all(checks.values()):
        raise ValueError("Inboxes capability check failed; verify beta access, full-access key, and CLI preview")
    return checks


def pages(config, args):
    cursor = None
    visited = set()
    while True:
        rows, following = page(config, args, cursor)
        yield from rows
        if following is None:
            return
        if following in visited:
            raise ValueError("Pagination cursor repeated")
        visited.add(following)
        cursor = following


def without_urls(value):
    if isinstance(value, dict):
        return {key: without_urls(item) for key, item in value.items() if key != "download_url"}
    if isinstance(value, list):
        return [without_urls(item) for item in value]
    return value


def download(url, target, expected_size=None, timeout=None):
    parts = urllib.parse.urlsplit(url)
    if parts.scheme != "https" or not parts.hostname or parts.username or parts.password or parts.port not in (None, 443):
        raise ValueError("Expected a provider-generated HTTPS download URL")
    addresses = socket.getaddrinfo(parts.hostname, 443, type=socket.SOCK_STREAM)
    if not addresses or any(not ipaddress.ip_address(item[4][0]).is_global for item in addresses):
        raise ValueError("Download host must resolve to public addresses")
    connection = http.client.HTTPSConnection(parts.hostname)
    created = False
    try:
        for address in addresses:
            raw_socket = None
            try:
                raw_socket = socket.create_connection((address[4][0], 443), timeout=timeout)
                connection.sock = ssl.create_default_context().wrap_socket(raw_socket, server_hostname=parts.hostname)
                break
            except OSError:
                if raw_socket:
                    raw_socket.close()
        else:
            raise OSError("No validated download address connected")
        connection.request("GET", urllib.parse.urlunsplit(("", "", parts.path or "/", parts.query, "")))
        response = connection.getresponse()
        if response.status != 200:
            raise ValueError("Download requires HTTP 200; redirects are refused")
        with target.open("xb") as output:
            created = True
            shutil.copyfileobj(response, output)
            output.flush()
            os.fsync(output.fileno())
        length = response.getheader("Content-Length")
        if length is not None and target.stat().st_size != int(length):
            raise ValueError("Download ended before the declared content length")
        if expected_size is not None and target.stat().st_size != expected_size:
            raise ValueError("Downloaded size differs from provider metadata")
    except Exception:
        if created:
            target.unlink(missing_ok=True)
        raise RuntimeError("Download failed; signed URLs are omitted from diagnostics") from None
    finally:
        connection.close()


def file_record(path, root):
    checksum = hashlib.sha256()
    with path.open("rb") as data:
        for block in iter(lambda: data.read(1024 * 1024), b""):
            checksum.update(block)
    return {"path": path.relative_to(root).as_posix(), "bytes": path.stat().st_size,
            "sha256": checksum.hexdigest()}


def verify(root):
    root = outside_git(root)
    manifest_path = root / "manifest.json"
    if manifest_path.is_symlink() or not manifest_path.is_file():
        raise ValueError("Manifest must be a regular file")
    manifest = json.loads(manifest_path.read_text())
    if not isinstance(manifest, dict) or type(manifest.get("format")) is not int or manifest["format"] != 1:
        raise ValueError("Unsupported manifest format")
    for field in ("files", "gaps", "limits"):
        if not isinstance(manifest.get(field), list):
            raise ValueError(f"Manifest {field} must be a list")
    for field in ("enumeration_complete", "content_complete"):
        if type(manifest.get(field)) is not bool:
            raise ValueError(f"Manifest {field} must be a boolean")
    listed = set()
    for record in manifest["files"]:
        if not isinstance(record, dict) or not isinstance(record.get("path"), str):
            raise ValueError("Manifest file records must name a string path")
        relative = Path(record["path"])
        if relative.is_absolute() or ".." in relative.parts or str(relative) in listed:
            raise ValueError("Unsafe or duplicate manifest path")
        listed.add(str(relative))
        path = root / relative
        if not path.resolve().is_relative_to(root) or path.is_symlink() or not path.is_file():
            raise ValueError("Manifest path must name a regular file inside the archive")
        if file_record(path, root) != record:
            raise ValueError(f"Archive verification failed: {relative}")
    actual = set()
    directories = [root]
    while directories:
        with os.scandir(directories.pop()) as entries:
            for entry in entries:
                path = Path(entry.path)
                if entry.is_symlink():
                    raise ValueError("Archive entries must be regular files or directories, never symlinks")
                if entry.is_dir(follow_symlinks=False):
                    directories.append(path)
                elif entry.is_file(follow_symlinks=False):
                    if path != manifest_path:
                        actual.add(str(path.relative_to(root)))
                else:
                    raise ValueError("Archive entries must be regular files or directories, never symlinks")
    if actual != listed:
        raise ValueError("Archive contains unlisted or missing files")
    return {"integrity_verified": True, "enumeration_complete": manifest["enumeration_complete"],
            "content_complete": manifest["content_complete"], "gaps": manifest["gaps"],
            "limits": manifest["limits"]}


def download_timeout(config):
    try:
        value = config["download_timeout_seconds"]
        timeout = float(value)
        if isinstance(value, bool) or not math.isfinite(timeout) or timeout <= 0:
            raise ValueError
    except (KeyError, TypeError, ValueError, OverflowError):
        raise ValueError("download_timeout_seconds must be a measured positive inactivity timeout") from None
    return timeout


def export(config, destination):
    timeout = download_timeout(config)
    root = outside_git(destination)
    root.mkdir(mode=0o700, parents=True, exist_ok=False)
    manifest = {"format": 1, "inbox_id": config["inbox_id"], "files": [], "gaps": [],
                "enumeration_complete": False, "content_complete": False,
                "limits": ["Paginated traversal is not an atomic snapshot; mail can move or be deleted.",
                           "Only provider-retained, accessible items are enumerated; this is not a restore format.",
                           "Outbound original raw MIME/full headers unavailable; bodies and provider metadata saved."]}

    def persist():
        temporary = root / ".manifest.tmp"
        with temporary.open("w") as output:
            output.write(encode(manifest) + "\n")
            output.flush()
            os.fsync(output.fileno())
        os.replace(temporary, root / "manifest.json")

    def save(relative, value):
        path = root / relative
        path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
        content = value if isinstance(value, bytes) else (encode(without_urls(value)) + "\n").encode()
        with path.open("xb") as output:
            output.write(content)
            output.flush()
            os.fsync(output.fileno())
        manifest["files"].append(file_record(path, root))
        persist()

    def fetch_bytes(relative, url, size=None):
        path = root / relative
        path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
        download(url, path, size, timeout=timeout)
        manifest["files"].append(file_record(path, root))
        persist()

    def gap(component, error):
        manifest["gaps"].append({"component": component, "reason": type(error).__name__})
        persist()

    def export_email(email, thread_id):
        email_id = identifier(email["id"])
        prefix = f"emails/{email_id}"
        save(prefix + "/native.json", {"thread_id": thread_id, "email": email})
        for field, suffix in (("text", "txt"), ("html", "html")):
            if isinstance(email.get(field), str):
                save(prefix + "/body." + suffix, email[field].encode())
        if email.get("direction") not in ("inbound", "outbound"):
            raise ValueError("Unknown email direction")
        args = ["emails"] + (["receiving"] if email["direction"] == "inbound" else [])
        try:
            public = cli(config, *args, "get", email_id)
            if public.get("id") != email_id or not email.get("message_id") or public.get("message_id") != email["message_id"]:
                raise ValueError("Public endpoint did not confirm the native Message-ID")
            save(prefix + "/provider.json", public)
        except (RuntimeError, ValueError, KeyError, OSError) as error:
            gap(prefix + "/provider", error)
            return
        raw = (public.get("raw") or {}).get("download_url")
        if raw:
            try:
                fetch_bytes(prefix + "/message.eml", raw)
            except (RuntimeError, ValueError, OSError) as error:
                gap(prefix + "/raw", error)
        elif email["direction"] == "inbound":
            gap(prefix + "/raw-unavailable", ValueError())
        found = set()
        try:
            for attachment in pages(config, args + ["attachments", email_id]):
                attachment_id = identifier(attachment["id"])
                if attachment_id in found:
                    raise ValueError("Repeated attachment ID")
                found.add(attachment_id)
                relative = prefix + f"/attachments/{attachment_id}"
                save(relative + ".json", attachment)
                try:
                    fetch_bytes(relative + ".bin", attachment["download_url"], attachment.get("size"))
                except (RuntimeError, ValueError, KeyError, OSError) as error:
                    gap(relative, error)
            if not {identifier(a["id"]) for a in email["attachments"]}.issubset(found):
                raise ValueError("Native attachments missing from public listing")
        except (RuntimeError, ValueError, KeyError, OSError) as error:
            gap(prefix + "/attachments", error)

    persist()
    inbox = config["inbox_id"]
    try:
        save("inbox.json", cli(config, "inboxes", "get", inbox))
        save("labels.json", cli(config, "inboxes", "labels", "list", "--inbox_id", inbox))
        found_threads, found_emails = set(), set()
        for thread in pages(config, ["inboxes", "threads", "list", "--inbox_id", inbox,
                                     "--folders", "inbox", "archive", "spam", "sent", "trash"]):
            thread_id = identifier(thread["id"])
            if thread_id in found_threads:
                continue
            found_threads.add(thread_id)
            save(f"threads/{thread_id}.json", thread)
            thread_emails = set()
            for email in pages(config, ["inboxes", "threads", "emails", "list", "--inbox_id", inbox,
                                       "--thread_id", thread_id]):
                thread_emails.add(email["id"])
                if email["id"] in found_emails:
                    continue
                found_emails.add(email["id"])
                export_email(email, thread_id)
            if "message_count" in thread and len(thread_emails) != thread["message_count"]:
                gap(f"threads/{thread_id}/count-changed", ValueError())
        for draft in pages(config, ["inboxes", "drafts", "list", "--inbox_id", inbox]):
            draft_id = identifier(draft["id"])
            full = cli(config, "inboxes", "drafts", "get", "--inbox_id", inbox, "--draft_id", draft_id)
            if full.get("id") != draft_id:
                raise ValueError("Unexpected draft identity")
            save(f"drafts/{draft_id}.json", full)
        manifest["enumeration_complete"] = True
        manifest["content_complete"] = not manifest["gaps"]
    except (RuntimeError, ValueError, KeyError, OSError) as error:
        gap("enumeration", error)
    persist()
    return {"archive": str(root), **verify(root)}


def copy_destination(destination):
    if not isinstance(destination, str) or destination.startswith("-") or not destination.endswith("/"):
        raise ValueError("archive_copy must be an existing destination directory ending in /")
    if ":" not in destination.split("/", 1)[0]:
        local = outside_git(destination)
        if not local.is_dir():
            raise ValueError("Local archive_copy directory must already exist")
        return str(local) + "/"
    return destination


def run(config, db):
    doctor(config)
    discovered = poll(config, db)
    name = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ") + "-" + uuid.uuid4().hex
    archive = outside_git(config["archive_dir"]) / name
    result = export(config, archive)
    result["pending_count"] = len(discovered["pending"])
    if config.get("archive_copy"):
        destination = copy_destination(config["archive_copy"])
        copied = subprocess.run(["rsync", "--archive", "--checksum", "--protect-args", "--",
                                 str(archive), destination], stdin=subprocess.DEVNULL,
                                capture_output=True, text=True, check=False)
        if copied.returncode:
            raise RuntimeError(f"Archive copy failed (rsync exit {copied.returncode}); local archive retained")
        result["copy"] = {"transferred": True, "verification": "rsync checksum transfer; no independent remote manifest rehash"}
    return result


def load_config(path, command):
    config = json.loads(outside_git(path).read_text())
    if not isinstance(config, dict):
        raise ValueError("Config must be a JSON object")
    try:
        config["inbox_id"] = identifier(config.get("inbox_id"))
    except ValueError:
        raise ValueError("inbox_id must be a UUID string") from None
    directory = config.get("state_dir")
    if not isinstance(directory, str) or not Path(directory).is_absolute():
        raise ValueError("state_dir must be an absolute private path")
    outside_git(directory)
    profile = config.get("profile")
    if profile is not None and (not isinstance(profile, str) or profile.startswith("-")):
        raise ValueError("Invalid CLI profile")
    if command in ("run", "export"):
        download_timeout(config)
    if command == "run":
        archive = config.get("archive_dir")
        if not isinstance(archive, str) or not archive.strip():
            raise ValueError("archive_dir must be a private path")
        outside_git(archive)
        if config.get("archive_copy"):
            copy_destination(config["archive_copy"])
    return config


def main():
    os.umask(0o077)
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--config", help="Trusted private JSON: inbox_id, state_dir, optional profile")
    commands = parser.add_subparsers(dest="command", required=True)
    for name in ("doctor", "poll", "pending"):
        commands.add_parser(name)
    commands.add_parser("restart-discovery", help="Clear only scan cursors after a stuck traversal; retained mail may be missed")
    commands.add_parser("ack").add_argument("email_id", type=identifier)
    command = commands.add_parser("review", help="Snapshot native draft; this does not grant send authority")
    command.add_argument("draft_id", type=identifier)
    command.add_argument("key", help="Stable logical action key, reused across restarts")
    command = commands.add_parser("send", help="Send only under existing user authority")
    command.add_argument("key")
    command.add_argument("--review-sha256", required=True, help="SHA-256 from the snapshot this caller inspected")
    command.add_argument("--authorized", action="store_true", required=True)
    commands.add_parser("reconcile").add_argument("key")
    commands.add_parser("run", help="Read/archive only; config adds archive_dir and optional rsync archive_copy")
    commands.add_parser("export").add_argument("--output", required=True, help="New private archive directory")
    commands.add_parser("verify").add_argument("archive", help="Verify local manifest bytes; no config or network needed")
    args = parser.parse_args()
    if args.command == "verify":
        print(encode(verify(args.archive)))
        return
    if not args.config:
        parser.error("--config is required except for verify")
    config = load_config(args.config, args.command)
    with state(config) as db:
        if args.command == "doctor":
            result = doctor(config)
        elif args.command == "poll":
            doctor(config)
            result = poll(config, db)
        elif args.command == "pending":
            result = {"pending": pending(db)}
        elif args.command == "restart-discovery":
            with db:
                db.execute("DELETE FROM scan")
            result = {"discovery_restarted": True, "limit": "Interrupted traversal gap; deleted mail cannot be recovered"}
        elif args.command == "ack":
            with db:
                changed = db.execute("UPDATE messages SET acknowledged=1 WHERE id=?", (args.email_id,)).rowcount
            if not changed:
                raise ValueError("Unknown email ID")
            result = {"acknowledged": args.email_id}
        elif args.command == "review":
            result = review(config, db, args.draft_id, args.key)
        elif args.command == "send":
            result = send(config, db, args.key, args.review_sha256)
        elif args.command == "export":
            doctor(config)
            result = export(config, args.output)
        elif args.command == "run":
            result = run(config, db)
        else:
            result = reconcile(config, db, args.key)
    print(encode(result))
    if result.get("enumeration_complete") is False or result.get("content_complete") is False:
        sys.exit(2)


if __name__ == "__main__":
    try:
        main()
    except BlockingIOError:
        print(encode({"error": "Another invocation owns this state directory"}), file=sys.stderr)
        sys.exit(75)
    except (ValueError, KeyError, OSError, RuntimeError, sqlite3.Error) as error:
        print(encode({"error": str(error)}), file=sys.stderr)
        sys.exit(1)
