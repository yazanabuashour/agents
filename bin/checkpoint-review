#!/bin/bash
set -Eeuo pipefail
shopt -s inherit_errexit
set +m

usage() {
  printf '%s\n' \
    'Usage:' \
    "  checkpoint-review --repo ABSOLUTE_PATH --patch FILE --context FILE \\" \
    "    --review correctness EFFORT --review simplification EFFORT \\" \
    '    [--review TYPE EFFORT]... [--custom-review EFFORT PROMPT]' \
    '' \
    'The caller supplies the approved before/after patch, including any prior' \
    'uncommitted baseline, and task requirements, non-goals, and prior decisions.' \
    'The patch must reverse-apply to the current worktree. An empty patch is a no-op.' \
    '' \
    'Required review types: correctness, simplification' \
    'Optional review types: test-reduction, security, test-gaps, api-compat, concurrency, policy' \
    'Request test-reduction only when the approved delta changes tests.' \
    'Valid efforts: low, medium, high, xhigh (extra high), max'
}

error() {
  printf 'error: %s\n' "$*" >&2
  exit 2
}

validate_effort() {
  case "$1" in
    low | medium | high | xhigh | max) ;;
    *) error "unknown reasoning effort: $1; valid values: low, medium, high, xhigh, max" ;;
  esac
}

if [[ ${1:-} == --help || ${1:-} == -h ]]; then
  usage
  exit 0
fi

declare -A inputs=() efforts=()
reviews=()
custom_prompt=''
while [[ $# -gt 0 ]]; do
  case "$1" in
    --repo | --patch | --context)
      option="${1#--}"
      [[ $# -ge 2 && -n ${2//[[:space:]]/} ]] || error "--$option requires a path"
      [[ ! ${inputs[$option]+set} ]] || error "--$option may be specified only once"
      inputs[$option]="$2"
      shift 2
      ;;
    --review | --custom-review)
      [[ $# -ge 3 ]] || error "$1 requires two arguments"
      if [[ $1 == --custom-review ]]; then
        review_type=custom
        effort="$2"
        [[ -n ${3//[[:space:]]/} ]] || error 'custom review prompt is empty'
        custom_prompt="$3"
      else
        review_type="$2"
        effort="$3"
        case "$review_type" in
          correctness | simplification | test-reduction | security | test-gaps | api-compat | concurrency | policy) ;;
          *) error "unknown review type: $review_type" ;;
        esac
      fi
      validate_effort "$effort"
      [[ ! ${efforts[$review_type]+set} ]] || error "duplicate review type: $review_type"
      efforts[$review_type]="$effort"
      reviews+=("$review_type")
      shift 3
      ;;
    *) error "unknown argument: $1" ;;
  esac
done

for option in repo patch context; do
  [[ ${inputs[$option]+set} ]] || error "--$option is required"
done
[[ ${inputs[repo]} == /* ]] || error '--repo requires an absolute path'
for review_type in correctness simplification; do
  [[ ${efforts[$review_type]+set} ]] || error "--review $review_type EFFORT is required"
done
for option in patch context; do
  [[ -f ${inputs[$option]} && -r ${inputs[$option]} ]] || error "--$option must be a readable file"
  [[ ${inputs[$option]} == /* ]] || inputs[$option]="$PWD/${inputs[$option]}"
done

for dependency in git pi setsid; do
  if ! command -v "$dependency" >/dev/null 2>&1; then
    printf 'error: %s is required\n' "$dependency" >&2
    exit 127
  fi
done
usable_fd=0
for fd_command in fd fdfind; do
  if command -v "$fd_command" >/dev/null 2>&1 &&
    "$fd_command" --max-results 1 -- '' >/dev/null 2>&1; then
    usable_fd=1
    break
  fi
done
if [[ $usable_fd != 1 ]]; then
  printf 'error: a usable fd or fdfind is required\n' >&2
  exit 127
fi
if ! command -v rg >/dev/null 2>&1 || ! rg --version >/dev/null 2>&1; then
  printf 'error: a usable rg is required\n' >&2
  exit 127
fi

repo_root="$(git -C "${inputs[repo]}" rev-parse --show-toplevel 2>/dev/null)" || error "not inside a git worktree: ${inputs[repo]}"
cd "$repo_root"
umask 077
review_dir="$(mktemp -d "${TMPDIR:-/tmp}/checkpoint-review.XXXXXX")"
summary_file="$review_dir/summary.txt"
report_file="$review_dir/report.md"
patch_file="$review_dir/approved.patch"
context_file="$review_dir/task-context.md"
pids=() names=() logs=() statuses=() result_files=()
failed=0

settle_reviews() {
  local i result
  for i in "${!pids[@]}"; do
    if [[ ! ${statuses[$i]+set} ]]; then
      if wait "${pids[$i]}"; then statuses[i]=0; else statuses[i]=$?; fi
      if [[ -f ${result_files[$i]} ]] && read -r result <"${result_files[$i]}" &&
        [[ $result =~ ^(0|[1-9][0-9]{0,2})$ ]] && ((result <= 255)); then
        statuses[i]="$result"
      fi
    fi
    if [[ ${statuses[$i]} != 0 ]]; then failed=1; fi
  done
}

finish() {
  local status="$?" pid i
  [[ $# == 0 ]] || status="$1"
  trap - INT TERM HUP EXIT
  # Completed supervisors have already killed their groups; never signal reused PIDs.
  local live_pids=()
  mapfile -t live_pids < <(
    jobs -pr
    jobs -ps
  )
  for pid in "${live_pids[@]}"; do
    kill -KILL -- "-$pid" 2>/dev/null || kill -KILL "$pid" 2>/dev/null || true
  done
  settle_reviews
  wait 2>/dev/null || true
  {
    for i in "${!pids[@]}"; do
      printf '%s status=%s log=%s\n' "${names[$i]}" "${statuses[$i]}" "${logs[$i]}"
    done
    printf 'End UTC: %s\nExit status: %s\n' "$(date -u +%FT%TZ)" "$status"
  } >>"$summary_file"
  exit "$status"
}
trap finish EXIT
trap 'finish 130' INT
trap 'finish 143' TERM
trap 'finish 129' HUP

worktree_snapshot() {
  local root="$1" path target nested_root ancestor remaining
  git -C "$root" rev-parse --verify --quiet HEAD || [[ $? == 1 ]]
  git -C "$root" ls-files --stage -z
  git -C "$root" ls-files -v -z
  git -C "$root" ls-files --cached --others --exclude-standard -z |
    while IFS= read -r -d '' path; do
      printf 'path:%s\0' "$path"
      ancestor="$root"
      remaining="$path"
      while [[ $remaining == */* ]]; do
        ancestor+="/${remaining%%/*}"
        remaining="${remaining#*/}"
        if [[ -L $ancestor ]]; then
          printf 'symlink-ancestor:%s\0' "$ancestor"
          readlink -z -- "$ancestor"
          continue 2
        fi
      done
      target="$root/$path"
      if [[ -e $target || -L $target ]]; then
        stat -c '%f' -- "$target"
      else
        printf 'missing\n'
      fi
      if [[ -L $target ]]; then
        readlink -z -- "$target"
      elif [[ -f $target ]]; then
        git hash-object --no-filters -- "$target"
      elif [[ -d $target && -e $target/.git ]]; then
        nested_root="$(git -C "$target" rev-parse --show-toplevel)"
        [[ $nested_root != "$(cd "$target" && pwd -P)" ]] || worktree_snapshot "$nested_root"
      fi
    done
}

worktree_hash() {
  worktree_snapshot "$repo_root" | git hash-object --stdin
}

{
  printf 'Repository: %s\nStart UTC: %s\n' "$repo_root" "$(date -u +%FT%TZ)"
  printf 'Review output: %s\nReview report: %s\n' "$review_dir" "$report_file"
  printf 'Requested reviews:'
  for review_type in "${reviews[@]}"; do printf ' %s=%s' "$review_type" "${efforts[$review_type]}"; done
  printf '\nUsage and cost: unavailable (text mode); historical usage: unavailable, not zero\n'
} >"$summary_file"
printf 'Repository: %s\nReview output: %s\n' "$repo_root" "$review_dir"
review_state_hash="$(worktree_hash)"
cp -- "${inputs[patch]}" "$patch_file"
cp -- "${inputs[context]}" "$context_file"
chmod 400 "$patch_file" "$context_file"
patch_hash="$(git hash-object --no-filters -- "$patch_file")"
context_hash="$(git hash-object --no-filters -- "$context_file")"
printf 'Git object hashes (%s):\nPatch: %s\nContext: %s\nWorktree before: %s\n' \
  "$(git rev-parse --show-object-format)" "$patch_hash" "$context_hash" "$review_state_hash" >>"$summary_file"

if [[ -s $patch_file ]] && ! git apply --reverse --check --whitespace=nowarn -- "$patch_file" >"$review_dir/patch-check.log" 2>&1; then
  printf 'error: invalid or stale patch; see %s/patch-check.log\n' "$review_dir" >&2
  exit 1
fi
if [[ -s $patch_file ]]; then
  REVIEW_MODEL="${REVIEW_MODEL:-$(model-role deep)}"
  [[ -n $REVIEW_MODEL ]] || error 'review model is empty'
else
  REVIEW_MODEL='not requested (empty patch)'
fi
printf 'Model argument: %s\n' "$REVIEW_MODEL" >>"$summary_file"
prepared_state_hash="$(worktree_hash)"
printf 'Worktree prepared: %s\n' "$prepared_state_hash" >>"$summary_file"
if [[ $prepared_state_hash != "$review_state_hash" ]]; then
  printf 'error: worktree changed while preparing reviewer context; supply a current patch and rerun\n' >&2
  exit 1
fi
if [[ ! -s $patch_file ]]; then
  printf 'Empty patch; no review checkpoint was run.\n' | tee "$report_file"
  exit 0
fi

review_prefix='Review only the approved delta in approved.patch against the requirements, non-goals, and prior decisions in task-context.md. The caller owns the before/after baseline, which may include earlier uncommitted edits. Use read-only tools to inspect relevant repository context and follow applicable context instructions. Inspect and report only. Do not edit files, run validation or another review gate, or delegate. Relate each actionable finding to the approved delta and supplied task contract. Put unrelated existing issues in a separate follow-up section, not checkpoint findings. To challenge an accepted decision, name it, provide new concrete failure evidence, and explain why the accepted constraints no longer suffice. Include severity, file:line references, the failure scenario or benefit, and the smallest safe fix. If there are no actionable findings for your focus, say so.'
declare -A prompts=(
  [correctness]='Focus on defects introduced by the delta: functional bugs, behavior regressions, data loss, broken error handling, and contract violations. Ignore style unless it hides a defect.'
  [simplification]='Focus on making the delta smaller, clearer, and harder to misuse without changing required behavior. Favor alternatives that complete the task while deleting more code than they add. Apply the Rule of Three and avoid speculative features. Prefer one-liners where they remain obvious. Identify unnecessary abstractions, wrappers, configuration, and compatibility machinery. Flag every added comment the code already conveys, every comment longer than one line except doc comments on exported declarations, and receipts, ticket IDs, dates, or history in code. Explaining rationale does not make a comment necessary. Check documentation for accuracy, content that existing docs already convey, point-in-time claims, and commands, examples, links, or behavior that disagree with the implementation; prefer trimming or deleting to adding. Do not reward compression or hidden behavior. Explain why each alternative preserves behavior.'
  ['test-reduction']='Find removable assertions, fixtures, helpers, and permutations in changed tests. For each proposed cut, identify where meaningful input, timing, origin, side-effect, and failure distinctions remain protected; move useful assertions into a surviving case before deleting it. Preserve call counts or multiple assertions when they express the contract or useful diagnosis. Reject fixture changes that let a negative test pass for the wrong reason. Do not request additional tests or invent cuts; no worthwhile reduction is a valid result.'
  ['test-gaps']='Focus on missing, weak, or misleading validation for changed behavior, bug fixes, migrations, and compatibility-sensitive changes. Name the exact behavior that should be tested.'
  [security]='Focus on concrete security regressions introduced or exposed by the delta: authentication, authorization, unsafe filesystem, shell, network, browser, or web-address handling, injection, path traversal, secret exposure, unsafe deserialization, privilege boundaries, and dependency or configuration weakening. Explain impact.'
  ['api-compat']='Focus on application programming interface, command-line interface, configuration, environment, schema, migration, generated client, documentation contract, rollout, and rollback compatibility regressions.'
  [concurrency]='Focus on concurrency, lifecycle, and operational correctness: races, async ordering, cancellation/cleanup, leaks, retry idempotency, transactions, stale cache/state, timing assumptions, and unsafe parallelism.'
  [policy]='Focus on orchestration-policy quality: ambiguous delegation rules, over-orchestration or under-orchestration, thread/worktree/subagent/goal sequencing contradictions, review/commit contract contradictions, and coding-agent portability.'
  [custom]="$custom_prompt"
)

run_pi() {
  trap - INT TERM HUP EXIT
  # shellcheck disable=SC2016
  exec setsid bash --noprofile --norc -c '
    set +m
    result_file="$1"
    shift
    status=0
    pi "$@" || status=$?
    printf "%s\n" "$status" >"$result_file.tmp" && mv -- "$result_file.tmp" "$result_file"
    # Retain the group leader until every owned group member receives cleanup.
    kill -KILL -- "-$$"
  ' checkpoint-review-supervisor "$3" \
    --print --no-session --model "$REVIEW_MODEL" --thinking "$1" \
    --no-approve --no-extensions --no-skills --no-prompt-templates --tools read,grep,find \
    "@$patch_file" "@$context_file" "$2"
}
for review_type in "${reviews[@]}"; do
  name="$review_type-review"
  [[ $review_type != test-gaps ]] || name=test-gap-review
  log="$review_dir/$name.log"
  prompt="$review_prefix ${prompts[$review_type]}"
  result_file="$review_dir/$name.status"
  run_pi "${efforts[$review_type]}" "$prompt" "$result_file" </dev/null >"$log" 2>&1 &
  pids+=("$!") names+=("$name") logs+=("$log") result_files+=("$result_file")
done
settle_reviews

: >"$report_file"
for i in "${!pids[@]}"; do
  {
    printf '## %s\n\n' "${names[$i]}"
    cat "${logs[$i]}"
    printf '\n'
    if [[ ${statuses[$i]} != 0 ]]; then
      printf '[reviewer exited with status %s; full log: %s]\n' "${statuses[$i]}" "${logs[$i]}"
    fi
    printf '\n'
  } >>"$report_file"
done
cat "$report_file"
final_state_hash="$(worktree_hash)"
printf 'Worktree after: %s\n' "$final_state_hash" >>"$summary_file"
if [[ $final_state_hash != "$review_state_hash" ]]; then
  printf 'error: worktree changed while reviewers were running; supply a current patch and rerun\n' >&2
  failed=1
fi
if [[ $(git hash-object --no-filters -- "$patch_file") != "$patch_hash" || $(git hash-object --no-filters -- "$context_file") != "$context_hash" ]]; then
  printf 'error: frozen review inputs changed\n' >&2
  failed=1
fi
printf 'Review report: %s\nReview metadata: %s\n' "$report_file" "$summary_file"
if [[ $failed != 0 ]]; then
  printf 'Review command failed; inspect the report and reviewer statuses.\n' >&2
  exit 1
fi
printf 'Checkpoint review complete. Address actionable findings before committing.\n'
